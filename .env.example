# ==========================================
# GENERAL & PORTS
# ==========================================
APP_ENV=development
FRONTEND_PORT=5173
BACKEND_PORT=8080
WORKER_PORT=8000

# ==========================================
# POSTGRESQL DATABASE
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=creator_platform
DB_USER=postgres
DB_PASSWORD=postgres_secret
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ==========================================
# REDIS QUEUE
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# SECURITY & AUTH
# ==========================================
JWT_SECRET=super_secret_jwt_key_minimum_32_characters_long_12345
JWT_EXPIRATION_MS=86400000

# ==========================================
# PAYMENT GATEWAY (Midtrans / Xendit Sandbox)
# ==========================================
PAYMENT_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
PAYMENT_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
PAYMENT_IS_PRODUCTION=false

# ==========================================
# ASSET STORAGE (S3 / MinIO / Cloudflare R2)
# ==========================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET_NAME=creator-assets
STORAGE_ACCESS_KEY=minioadmin